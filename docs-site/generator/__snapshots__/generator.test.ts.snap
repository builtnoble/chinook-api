exports[`generate matches the recorded pages 1`] = `
"export const metadata = {
  title: "Albums",
  description: "Albums, each with the artist who made it.",
}

# Albums

Albums, each with the artist who made it. {{ className: 'lead' }}

## The album model

The album model contains the following properties.

### Properties

<Properties>
  <Property name="id" type="integer">
    Unique identifier for the album.
  </Property>

  <Property name="title" type="string">
    Title of the album.
  </Property>

  <Property name="artist_id" type="integer">
    Identifier of the album artist.
  </Property>

  <Property name="artist" type="object">
    The artist who made the album.
  </Property>

  <Property name="artist.id" type="integer">
    Unique identifier for the artist.
  </Property>

  <Property name="artist.name" type="string">
    Name of the artist.
  </Property>
</Properties>

---

## List all albums {{ tag: 'GET', label: '/api/albums' }}

<Row>
  <Col>
    Returns a paginated list of albums. Each album includes its artist.

    ### Optional parameters

    <Properties>
      <Property name="limit" type="number, optional">
        Number of items per page. Defaults to 10, or the total if fewer.
      </Property>

      <Property name="page" type="number, optional">
        Page number to return, starting at 1. Defaults to 1.
      </Property>
    </Properties>

    ### Response attributes

    <Properties>
      <Property name="data" type="object[]">
        The albums on this page. See [the album model](#the-album-model).
      </Property>

      <Property name="pagination" type="object">
        Where the returned page sits among all pages.
      </Property>

      <Property name="pagination.current_page" type="number">
        The page returned.
      </Property>

      <Property name="pagination.per_page" type="number">
        Number of items per page.
      </Property>

      <Property name="pagination.total_items" type="number">
        Total number of items across all pages.
      </Property>

      <Property name="pagination.total_pages" type="number">
        Total number of pages.
      </Property>

      <Property name="pagination.prev_page_url" type="string | null">
        Path of the previous page, or null on the first page.
      </Property>

      <Property name="pagination.next_page_url" type="string | null">
        Path of the next page, or null on the last page.
      </Property>
    </Properties>

    ### Errors

    <Properties>
      <Property name="400" type="error">
        The query is invalid, or the requested page or limit is out of range.
      </Property>

      <Property name="401" type="error">
        Missing or invalid credentials.
      </Property>
    </Properties>
  </Col>

  <Col sticky>
    <CodeGroup title="Request" tag="GET" label="/api/albums">
      \`\`\`bash {{ title: 'cURL' }}
      curl --request GET \\
        --url http://localhost:3000/api/albums \\
        --header 'Authorization: Bearer {token}'
      \`\`\`

      \`\`\`ts {{ title: 'TypeScript' }}
      const url = 'http://localhost:3000/api/albums';
      const options = {method: 'GET', headers: {Authorization: 'Bearer {token}'}};

      fetch(url, options)
        .then(res => res.json())
        .then(json => console.log(json))
        .catch(err => console.error(err));
      \`\`\`

      \`\`\`php {{ title: 'PHP' }}
      <?php
      require_once('vendor/autoload.php');

      $client = new \\GuzzleHttp\\Client();

      $response = $client->request('GET', 'http://localhost:3000/api/albums', [
        'headers' => [
          'Authorization' => 'Bearer {token}',
        ],
      ]);

      echo $response->getBody();
      \`\`\`
    </CodeGroup>

    \`\`\`json {{ title: 'Response' }}
    {
      "data": [
        {
          "id": 1,
          "title": "For Those About To Rock We Salute You",
          "artist_id": 1,
          "artist": {
            "id": 1,
            "name": "AC/DC"
          }
        }
      ],
      "pagination": {
        "current_page": 1,
        "per_page": 1,
        "total_items": 3,
        "total_pages": 3,
        "prev_page_url": null,
        "next_page_url": "/api/albums?page=2"
      }
    }
    \`\`\`

    \`\`\`json {{ title: 'Error response (400)' }}
    {
      "type": "about:blank",
      "title": "Bad Request",
      "status": 400,
      "detail": "The request is not valid.",
      "code": "validation_failed",
      "errors": [
        {
          "field": "/page",
          "in": "query",
          "message": "Invalid input: expected number, received NaN",
          "code": "invalid_type"
        }
      ]
    }
    \`\`\`

    \`\`\`json {{ title: 'Error response (400)' }}
    {
      "type": "about:blank",
      "title": "Bad Request",
      "status": 400,
      "detail": "Page cannot exceed 35.",
      "code": "page_out_of_range"
    }
    \`\`\`

    \`\`\`json {{ title: 'Error response (401)' }}
    {
      "type": "about:blank",
      "title": "Unauthorized",
      "status": 401,
      "detail": "Missing or invalid credentials.",
      "code": "unauthorized"
    }
    \`\`\`
  </Col>
</Row>

---

## Create an album {{ tag: 'POST', label: '/api/albums' }}

<Row>
  <Col>
    Creates an album for an existing artist and returns it with its artist. An \`artist_id\` that does not exist, or whose artist is deleted, returns 422. Requires the admin role.

    ### Required attributes

    <Properties>
      <Property name="title" type="string">
        Title of the album.
      </Property>

      <Property name="artist_id" type="integer">
        Identifier of the album artist, who must exist.
      </Property>
    </Properties>

    ### Response attributes

    <Properties>
      <Property name="data" type="object">
        The album. See [the album model](#the-album-model).
      </Property>
    </Properties>

    ### Errors

    <Properties>
      <Property name="400" type="error">
        The body is not valid JSON, or a field is missing, unknown or of the wrong type.
      </Property>

      <Property name="401" type="error">
        Missing or invalid credentials.
      </Property>

      <Property name="403" type="error">
        The caller is signed in but is not an admin, or the request is a cookie write from an origin that is not allowed.
      </Property>

      <Property name="409" type="error">
        A unique value collides with an existing row.
      </Property>

      <Property name="422" type="error">
        A field refers to a parent that does not exist or is deleted, or a value is too long.
      </Property>
    </Properties>
  </Col>

  <Col sticky>
    <CodeGroup title="Request" tag="POST" label="/api/albums">
      \`\`\`bash {{ title: 'cURL' }}
      curl --request POST \\
        --url http://localhost:3000/api/albums \\
        --header 'Authorization: Bearer {token}' \\
        --header 'Content-Type: application/json' \\
        --data '
      {
        "title": "For Those About To Rock We Salute You",
        "artist_id": 1
      }
      '
      \`\`\`

      \`\`\`ts {{ title: 'TypeScript' }}
      const url = 'http://localhost:3000/api/albums';
      const options = {
        method: 'POST',
        headers: {Authorization: 'Bearer {token}', 'Content-Type': 'application/json'},
        body: JSON.stringify({title: 'For Those About To Rock We Salute You', artist_id: 1})
      };

      fetch(url, options)
        .then(res => res.json())
        .then(json => console.log(json))
        .catch(err => console.error(err));
      \`\`\`

      \`\`\`php {{ title: 'PHP' }}
      <?php
      require_once('vendor/autoload.php');

      $client = new \\GuzzleHttp\\Client();

      $response = $client->request('POST', 'http://localhost:3000/api/albums', [
        'body' => '{"title":"For Those About To Rock We Salute You","artist_id":1}',
        'headers' => [
          'Authorization' => 'Bearer {token}',
          'Content-Type' => 'application/json',
        ],
      ]);

      echo $response->getBody();
      \`\`\`
    </CodeGroup>

    \`\`\`json {{ title: 'Response' }}
    {
      "data": {
        "id": 1,
        "title": "For Those About To Rock We Salute You",
        "artist_id": 1,
        "artist": {
          "id": 1,
          "name": "AC/DC"
        }
      }
    }
    \`\`\`

    \`\`\`json {{ title: 'Error response (400)' }}
    {
      "type": "about:blank",
      "title": "Bad Request",
      "status": 400,
      "detail": "The request is not valid.",
      "code": "validation_failed",
      "errors": [
        {
          "field": "/name",
          "in": "body",
          "message": "Invalid input: expected string, received number",
          "code": "invalid_type"
        }
      ]
    }
    \`\`\`

    \`\`\`json {{ title: 'Error response (400)' }}
    {
      "type": "about:blank",
      "title": "Bad Request",
      "status": 400,
      "detail": "Malformed JSON in request body",
      "code": "bad_request"
    }
    \`\`\`

    \`\`\`json {{ title: 'Error response (401)' }}
    {
      "type": "about:blank",
      "title": "Unauthorized",
      "status": 401,
      "detail": "Missing or invalid credentials.",
      "code": "unauthorized"
    }
    \`\`\`

    \`\`\`json {{ title: 'Error response (403)' }}
    {
      "type": "about:blank",
      "title": "Forbidden",
      "status": 403,
      "detail": "This action requires the admin role.",
      "code": "forbidden"
    }
    \`\`\`

    \`\`\`json {{ title: 'Error response (409)' }}
    {
      "type": "about:blank",
      "title": "Conflict",
      "status": 409,
      "detail": "A row with that value already exists.",
      "code": "duplicate_value"
    }
    \`\`\`

    \`\`\`json {{ title: 'Error response (422)' }}
    {
      "type": "about:blank",
      "title": "Unprocessable Content",
      "status": 422,
      "detail": "The row refers to a parent that does not exist.",
      "code": "invalid_reference"
    }
    \`\`\`
  </Col>
</Row>

