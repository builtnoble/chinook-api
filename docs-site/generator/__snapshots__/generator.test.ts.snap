## Create an artist {{ tag: 'POST', label: '/api/artists' }}

<Row>
  <Col>

    Creates an artist and returns it. Requires the admin role.

    ### Required attributes

    <Properties>
      <Property name="name" type="string">
        Name of the artist.
      </Property>
    </Properties>

    ### Response attributes

    <Properties>
      <Property name="data" type="object">
        The artist. See [the artist model](#the-artist-model).
      </Property>
    </Properties>

    ### Errors

    <Properties>
      <Property name="400" type="error">
        The body is not valid JSON, or a field is missing, unknown or of the wrong type.
      </Property>
      <Property name="401" type="error">
        Missing or invalid credentials.
      </Property>
      <Property name="403" type="error">
        The caller is signed in but is not an admin, or the request is a cookie write from an origin that is not allowed.
      </Property>
      <Property name="409" type="error">
        A unique value collides with an existing row.
      </Property>
      <Property name="422" type="error">
        A field refers to a parent that does not exist or is deleted, or a value is too long.
      </Property>
    </Properties>

  </Col>
  <Col sticky>

    <CodeGroup title="Request" tag="POST" label="/api/artists">

    \`\`\`bash {{ title: 'cURL' }}
    curl -X POST http://localhost:3000/api/artists \\
      -H "Authorization: Bearer {token}" \\
      -H "Content-Type: application/json" \\
      -d '{"name":"AC/DC"}'
    \`\`\`

    \`\`\`js
    const response = await fetch('http://localhost:3000/api/artists', {
      method: 'POST',
      headers: {
        Authorization: \`Bearer \${token}\`,
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({ name: 'AC/DC' }),
    })
    const body = await response.json()
    \`\`\`

    </CodeGroup>

    \`\`\`json {{ title: 'Response' }}
    {
      "data": {
        "id": 1,
        "name": "AC/DC"
      }
    }
    \`\`\`

    \`\`\`json {{ title: 'Error response (400)' }}
    {
      "success": false,
      "data": {
        "name": 42
      },
      "error": [
        {
          "code": "invalid_type",
          "message": "Invalid input: expected string, received number",
          "path": [
            "name"
          ]
        }
      ]
    }
    \`\`\`

    \`\`\`json {{ title: 'Error response (400)' }}
    {
      "error": "Malformed JSON in request body"
    }
    \`\`\`

    \`\`\`json {{ title: 'Error response (401)' }}
    {
      "message": "Unauthorized"
    }
    \`\`\`

    \`\`\`json {{ title: 'Error response (403)' }}
    {
      "error": "This action requires the admin role."
    }
    \`\`\`

    \`\`\`json {{ title: 'Error response (409)' }}
    {
      "error": "A row with that value already exists."
    }
    \`\`\`

    \`\`\`json {{ title: 'Error response (422)' }}
    {
      "error": "The row refers to a parent that does not exist."
    }
    \`\`\`

  </Col>
</Row>

---

