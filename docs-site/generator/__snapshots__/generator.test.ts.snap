## Delete an album {{ tag: 'DELETE', label: '/api/albums/:id' }}

<Row>
  <Col>
    Deletes the album with the given id and returns it with its artist. The album is kept but no longer listed. While the album has tracks the delete is refused with 409, unless \`cascade=true\`, which deletes the tracks too, all or nothing. An unknown or deleted id returns 404. Requires the admin role.

    ### Required parameters

    <Properties>
      <Property name="id" type="number">
        Unique identifier of the item.
      </Property>
    </Properties>

    ### Optional parameters

    <Properties>
      <Property name="cascade" type="&#x22;true&#x22; | &#x22;false&#x22;, optional">
        Set to \`true\` to delete what depends on the item too. Defaults to \`false\`.
      </Property>
    </Properties>

    ### Response attributes

    <Properties>
      <Property name="data" type="object">
        The album. See [the album model](#the-album-model).
      </Property>
    </Properties>

    ### Errors

    <Properties>
      <Property name="400" type="error">
        The id is not a number, or a query parameter is invalid.
      </Property>

      <Property name="401" type="error">
        Missing or invalid credentials.
      </Property>

      <Property name="403" type="error">
        The caller is signed in but is not an admin, or the request is a cookie write from an origin that is not allowed.
      </Property>

      <Property name="404" type="error">
        No item has the requested id, or it has been deleted.
      </Property>

      <Property name="409" type="error">
        The album still has tracks, and \`cascade=true\` was not passed.
      </Property>
    </Properties>
  </Col>

  <Col sticky>
    <CodeGroup title="Request" tag="DELETE" label="/api/albums/1">
      \`\`\`bash {{ title: 'cURL' }}
      curl --request DELETE \\
        --url http://localhost:3000/api/albums/1 \\
        --header 'Authorization: Bearer {token}'
      \`\`\`

      \`\`\`ts {{ title: 'TypeScript' }}
      const url = 'http://localhost:3000/api/albums/1';
      const options = {method: 'DELETE', headers: {Authorization: 'Bearer {token}'}};

      fetch(url, options)
        .then(res => res.json())
        .then(json => console.log(json))
        .catch(err => console.error(err));
      \`\`\`

      \`\`\`php {{ title: 'PHP' }}
      <?php
      require_once('vendor/autoload.php');

      $client = new \\GuzzleHttp\\Client();

      $response = $client->request('DELETE', 'http://localhost:3000/api/albums/1', [
        'headers' => [
          'Authorization' => 'Bearer {token}',
        ],
      ]);

      echo $response->getBody();
      \`\`\`
    </CodeGroup>

    \`\`\`json {{ title: 'Response' }}
    {
      "data": {
        "id": 1,
        "title": "For Those About To Rock We Salute You",
        "artist_id": 1,
        "artist": {
          "id": 1,
          "name": "AC/DC"
        }
      }
    }
    \`\`\`

    \`\`\`json {{ title: 'Error response (400)' }}
    {
      "type": "about:blank",
      "title": "Bad Request",
      "status": 400,
      "detail": "The request is not valid.",
      "code": "validation_failed",
      "errors": [
        {
          "field": "/id",
          "in": "path",
          "message": "Invalid input: expected number, received NaN",
          "code": "invalid_type"
        }
      ]
    }
    \`\`\`

    \`\`\`json {{ title: 'Error response (401)' }}
    {
      "type": "about:blank",
      "title": "Unauthorized",
      "status": 401,
      "detail": "Missing or invalid credentials.",
      "code": "unauthorized"
    }
    \`\`\`

    \`\`\`json {{ title: 'Error response (403)' }}
    {
      "type": "about:blank",
      "title": "Forbidden",
      "status": 403,
      "detail": "This action requires the admin role.",
      "code": "forbidden"
    }
    \`\`\`

    \`\`\`json {{ title: 'Error response (404)' }}
    {
      "type": "about:blank",
      "title": "Not Found",
      "status": 404,
      "detail": "Album not found.",
      "code": "not_found"
    }
    \`\`\`

    \`\`\`json {{ title: 'Error response (409)' }}
    {
      "type": "about:blank",
      "title": "Conflict",
      "status": 409,
      "detail": "The album has 12 tracks. Delete them first, or pass cascade=true.",
      "code": "delete_blocked"
    }
    \`\`\`
  </Col>
</Row>
"
