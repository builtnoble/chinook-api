{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "types": ["bun"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "paths": {
            "@/*": ["./generator/*"]
        }
    },
    "include": ["generator", "scripts", "tests"]
}
